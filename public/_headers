/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://finplanner.ska97homelab.uk https://finplanner-api-6osw.onrender.com wss://finplanner-api-6osw.onrender.com https://www.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com https://www.googleapis.com https://accounts.google.com; worker-src 'self'; manifest-src 'self'; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Service worker + manifest must always be revalidated or an installed PWA never sees a new version.
# "! Cache-Control" detaches the immutable rule inherited from /*.js above.
/ngsw.json
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/ngsw-worker.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/safety-worker.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: no-cache
